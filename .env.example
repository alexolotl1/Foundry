# Supabase project credentials (public/anon key is safe for client use).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs the /login session cookie (src/lib/session.ts). Falls back to a
# fixed dev value if unset, which is fine locally but should be a random
# string before this goes anywhere real — anyone who knows the fallback can
# forge a session cookie for any club id.
SESSION_SECRET=
